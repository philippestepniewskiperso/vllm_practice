# Copier vers .env et remplir.

# Endpoint vLLM (OpenAI-compatible). Remplacer <IP> par l'IP de sortie Terraform.
VLLM_BASE_URL=http://<IP>:8000/v1

# vLLM ignore la cle mais le SDK OpenAI l'exige.
VLLM_API_KEY=EMPTY

# Modele servi (doit matcher --model cote serveur = var `model` Terraform).
MODEL=Qwen/Qwen2.5-0.5B-Instruct

SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=